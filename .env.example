# Copy to .env (auto-loaded from the current working directory) or export as env vars.
# Every source is optional: the tool runs with zero keys using only the free sources
# (company website scraper + PGP keyservers). Each key you add widens coverage.

# --- Email discovery APIs -------------------------------------------------
HUNTER_API_KEY=
APOLLO_API_KEY=
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=
PROSPEO_API_KEY=

# --- Name / profile discovery --------------------------------------------
# Needed for org member listing; without it GitHub still works but rate-limits hard.
GITHUB_TOKEN=

# --- Search-engine dorking (any one is enough) ---------------------------
# No key at all? Point SEARXNG_URL at a SearXNG instance you run or one that
# accepts you; keyless DuckDuckGo/Bing fallbacks are tried automatically but are
# usually captcha-blocked from datacenter IPs.
SEARXNG_URL=
SERPER_API_KEY=
BRAVE_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# --- SMTP verification ----------------------------------------------------
# Use an address you control on a domain with SPF configured for it.
# Never leave the default: MAIL FROM on the target's own domain gets rejected.
VERIFY_FROM=noreply@example.com
# Outbound port 25 blocked on your network? Send only the SMTP probes through a host that
# allows it:  ssh -N -D 1080 user@your-vps   then set
# SMTP_PROXY=socks5://127.0.0.1:1080
# (user:pass@ is supported for authenticated proxies). Unset = connect directly.
# An address you KNOW exists on the scanned domain. If the mail server refuses it during a
# scan, its "no such user" answers are treated as throttling and retried, not trusted.
# VERIFY_CONTROL=you@yourcompany.com

# --- MongoDB result cache (optional, used by the HTTP API) -----------------
# Any of these names works; the first one found wins.
# MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net
# MONGO_URI=, MONGODB_URL=, MONGO_URL=, DATABASE_URL=
# MONGODB_DB=ehunter
# MONGODB_COLLECTION=domains
